# ─── Local dev defaults (do NOT use these values in production) ───────────────
DEV_BYPASS_AUTH=true
DEV_ADMIN=true

# ─── Supabase (use `supabase start` locally or plug in your hosted keys) ──────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI — Groq (REQUIRED for all AI features: Dr. Eams, IDARi, BoogieMan, ForgeEngin)
# Without this key all AI routes degrade to simulation mode.
# Get key at https://console.groq.com
GROQ_API_KEY=

# ─── AI — Anthropic (CodeEngin AI Co-pilot)
# Without this key the CodeEngin AI assistant shows a "key not set" message.
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── YouTube Data API v3 (server-side only)
# Required for /api/youtube/* routes and the Dreamr discovery feed.
# Routes gracefully degrade if absent.
YOUTUBE_API_KEY=

# ─── Google OAuth (YouTube Connector)
# Register callback at http://localhost:3000/api/connectors/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Instagram OAuth (Instagram Connector)
# Register callback at http://localhost:3000/api/connectors/instagram/oauth/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ─── Voice Clone (Content Intelligence — ElevenLabs)
ELEVENLABS_API_KEY=

# ─── CI & Security
CI_API_KEY=dev-ci-key-change-in-production

# ─── Observability
METRICS_BEARER_TOKEN=dev-metrics-token-change-in-production

# ─── Optional: ShellHub device management
# SHELLHUB_API_KEY=

# ─── Optional: Hugging Face inference (dr-eams/hf route)
# HF_API_TOKEN=

# ─── Optional: LiveKit (Shared Dream voice/video rooms)
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
