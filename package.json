{
  "name": "dreamengin",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "build-memory:sync": "node scripts/sync-build-memory.mjs",
    "build-memory:check": "node scripts/check-build-memory-drift.mjs",
    "repo-state": "node scripts/analyze-repo-state.mjs",
    "preflight": "node scripts/vercel-preflight.cjs . && node scripts/spec-check.cjs . && pnpm run typecheck && pnpm run lint && pnpm run test:ci",
    "build:gamesengin": "tsc --project tsconfig.gamesengin.json --noEmit",
    "build:games": "tsc --project tsconfig.games.json --noEmit",
    "test:games": "vitest run tests/game-navigation.test.ts tests/game-remote-regression.test.ts tests/game-quality-plan.test.ts tests/report-driven-game-agent.test.ts",
    "asbuild:debug": "asc assembly/index.ts --target debug --exportRuntime --enable simd --outFile public/workers/engin-shader.wasm",
    "asbuild:release": "asc assembly/index.ts --target release --optimize --enable simd --outFile public/workers/engin-shader.wasm"
  },
  "dependencies": {
    "@babylonjs/core": "^9.5.0",
    "@babylonjs/havok": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@react-three/drei": "^10.10.0",
    "@react-three/fiber": "^9.6.0",
    "@supabase/ssr": "^0.11.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tensorflow/tfjs": "^4.25.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.25.0",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.580.0",
    "next": "^16.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.15.0",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "uuid": "^13.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dnd": "^3.1.0",
    "@types/react-dom": "^19.2.12",
    "@types/three": "^0.185.0",
    "assemblyscript": "^0.28.5",
    "eslint": "^9.5.0",
    "eslint-config-next": "^16.5.0",
    "pixi-viewport": "^6.1.0",
    "pixi.js": "^8.20.0",
    "react-dnd": "^16.1.0",
    "react-dnd-html5-backend": "^16.1.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.8",
    "typescript": "^6.1.0",
    "vitest": "^4.5.0"
  }
}
