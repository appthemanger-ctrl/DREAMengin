{
  "name": "dreamengin",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "build-memory:sync": "node scripts/sync-build-memory.mjs",
    "build-memory:check": "node scripts/check-build-memory-drift.mjs",
    "check:root-hygiene": "node scripts/check-root-hygiene.mjs",
    "check:engin-filenames": "node scripts/check-engin-filenames.mjs",
    "full-code:export": "node scripts/export-full-code.mjs",
    "repo-state": "node scripts/analyze-repo-state.mjs",
    "preflight": "node scripts/vercel-preflight.cjs . && pnpm run check:root-hygiene && node scripts/spec-check.cjs . && node scripts/check-engin-filenames.mjs && pnpm run typecheck && pnpm run lint && pnpm run test:ci && pnpm run check:orphans",
    "wire:orphans": "node scripts/wire-orphans.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "build:gamesengin": "tsc --project tsconfig.gamesengin.json --noEmit",
    "build:games": "tsc --project tsconfig.games.json --noEmit",
    "viz:build": "node repo-visualizer/analyzer.mjs",
    "viz:serve": "node repo-visualizer/server.mjs",
    "viz": "pnpm viz:build && pnpm viz:serve",
    "test:games": "vitest run tests/game-navigation.test.ts tests/game-remote-regression.test.ts tests/game-quality-plan.test.ts tests/report-driven-game-agent.test.ts",
    "asbuild:debug": "asc assembly/index.ts --target debug --exportRuntime --enable simd --outFile public/workers/engin-shader.wasm",
    "asbuild:release": "asc assembly/index.ts --target release --optimize --enable simd --outFile public/workers/engin-shader.wasm",
    "asbuild:mad-maxi": "asc assembly/mad-maxi-player.ts -o public/cartridges/mad-maxi/logic/main.wasm --optimizeLevel 3 --shrinkLevel 2 --enable simd --enable bulk-memory",
    "gameengin:maestro": "tsx scripts/gameengin/maestro-analyze.ts",
    "gameengin:prophet": "tsx scripts/gameengin/prophet-run.ts",
    "gameengin:mechanic": "tsx scripts/gameengin/mechanic-run.ts",
    "gameengin:artisan": "tsx scripts/gameengin/artisan-run.ts",
    "gameengin:writer": "tsx scripts/gameengin/writer-run.ts",
    "gameengin:upgrader": "tsx scripts/gameengin/upgrader-run.ts",
    "gameengin:package": "tsx scripts/gameengin/package-cartridge.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.1.0",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/loaders": "^9.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "next": "^16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rss-parser": "^3.13.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.0",
    "uuid": "^13.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@webgpu/types": "^0.1.69",
    "assemblyscript": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "glob": "^13.0.6",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.17.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^28.0.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
