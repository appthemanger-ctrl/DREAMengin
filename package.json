{
  "name": "dreamengin",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "preflight": "pnpm run typecheck && pnpm run lint && pnpm run test:ci",
    "asbuild:release": "asc assembly/index.ts --target release --optimize --enable simd --outFile public/workers/engin-shader.wasm"
  },
  "dependencies": {
    "@babylonjs/core": "^9.1.0",
    "@babylonjs/havok": "^1.4.1",
    "@supabase/supabase-js": "^2.103.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.581.0",
    "next": "^16.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zod": "^4.5.1",
    "zustand": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "allowBuilds": {
      "@babylonjs/havok": true,
      "assemblyscript": true
    }
  }
}
