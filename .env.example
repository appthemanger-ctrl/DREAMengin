# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Owner Identity (REQUIRED — no fallback)
# The Supabase account email that has owner-level access to admin routes and the AI Triad.
# If this is not set, isOwner() always returns false and all admin endpoints are locked.
OWNER_EMAIL=

# ─── AI — Groq (REQUIRED for all AI features: Dr. Eams, IDARi, BoogieMan, ForgeEngin)
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ─── AI — Anthropic (CodeEngin AI Co-pilot)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── YouTube Data API v3 (server-side only)
# Required for /api/youtube/* routes and the Dreamr discovery feed.
# Get key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# ─── Google OAuth (YouTube Connector)
# Register at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://your-domain.com/api/connectors/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Instagram OAuth (Instagram Connector)
# Register at https://developers.facebook.com → My Apps → Instagram Basic Display
# Authorized redirect URI: https://your-domain.com/api/connectors/instagram/oauth/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ─── Generative Fill (ContentEngin — Replicate)
# Get token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ─── Voice Clone (Content Intelligence — ElevenLabs)
# Get key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# ─── Webhook Ingestion (YouTube WebSub + Meta/Instagram)
# Set a strong random string. Must match hub.verify_token in your Meta App webhook config.
# Also used to verify incoming Instagram webhooks alongside INSTAGRAM_CLIENT_SECRET.
WEBHOOK_VERIFY_TOKEN=

# ─── Cron Jobs (Vercel Cron / self-hosted scheduler)
# Set a strong random secret. Vercel sends it automatically as: Authorization: Bearer <secret>
CRON_SECRET=

# ─── CI & Security
# Strong random secret for /api/security/scan. Set same value in GitHub Actions secrets.
CI_API_KEY=

# ─── Observability (Prometheus scraping protection)
# Set a strong random token. Pass as Authorization: Bearer <token> from your Prometheus scraper.
METRICS_BEARER_TOKEN=

# ─── Optional: ShellHub device management
# SHELLHUB_API_KEY=

# ─── Optional: Hugging Face inference (dr-eams/hf route)
# HF_API_TOKEN=

# ─── Optional: LiveKit (Shared Dream voice/video rooms)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
