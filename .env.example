# ===========================================
# DREAMengin Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Session/Security (Required) ---
SESSION_SECRET=generate-a-random-32-char-string

# --- Admin Access (Optional) ---
ADMIN_UNLOCK_KEY=your-admin-unlock-key
INNERDREAMS_PASSWORD=your-innerdreams-password

# --- Horizon Firewall (Optional) ---
# HORIZON_LEDGER_SECRET=random-secret-for-signed-ledger
# HORIZON_CSP_FRAME_SRC=https://additional-embed-domains.com

# --- Feature Flags (Optional) ---
# NEXT_PUBLIC_ENABLE_VOICE=true
# NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
