# DREAMengin — Environment Variables
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VERCEL SETUP — exact variable names to add in
#   Vercel → Project → Settings → Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# If you used the Vercel-Supabase integration these are already injected —
# the app will pick them up automatically with no extra action needed:
#
#   NEXT_PUBLIC_SUPABASE_URL              ← URL  (injected by integration)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  ← anon key  (injected, new name)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY         ← anon key  (injected, legacy name)
#   dreamengin_SUPABASE_URL               ← URL  (injected, project-prefixed)
#   dreamengin_SUPABASE_ANON_KEY          ← anon key  (injected, project-prefixed)
#   dreamengin_SUPABASE_JWT_SECRET        ← JWT secret  (injected)
#   dreamengin_SUPABASE_SERVICE_ROLE_KEY  ← service-role key  (injected)
#
# If you did NOT use the integration, add at minimum:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (or NEXT_PUBLIC_SUPABASE_ANON_KEY)
#
# The app also accepts the legacy custom names used before the integration:
#   NEXT_PUBLIC_dreamengin_SUPABASE_URL
#   NEXT_PUBLIC_dreamengin_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_dreamengin_SUPABASE_PUBLISHABLE_KEY
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Standard Supabase / Vercel-integration names (preferred) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key   # legacy alias — use either

# ── Project-prefixed names (injected automatically by Vercel-Supabase) ────────
dreamengin_SUPABASE_URL=https://your-project.supabase.co
dreamengin_SUPABASE_ANON_KEY=your-anon-key
dreamengin_SUPABASE_JWT_SECRET=your-jwt-secret
dreamengin_SUPABASE_SECRET_KEY=your-service-role-key
dreamengin_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # alias for above

# ── Postgres direct-connection strings (injected by Vercel-Supabase) ──────────
# dreamengin_POSTGRES_URL=postgresql://...
# dreamengin_POSTGRES_URL_NON_POOLING=postgresql://...
# dreamengin_POSTGRES_PRISMA_URL=postgresql://...
# dreamengin_POSTGRES_HOST=...
# dreamengin_POSTGRES_DATABASE=...
# dreamengin_POSTGRES_USER=...
# dreamengin_POSTGRES_PASSWORD=...

# ── AI providers (server-side only — never NEXT_PUBLIC_) ─────────────────────
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# ── Session & admin security ──────────────────────────────────────────────────
SESSION_SECRET=your-strong-session-secret
INNERDREAMS_PASSWORD=your-strong-admin-password
ADMIN_UNLOCK_KEY=your-admin-unlock-key
# ADMIN_LOCKOUT=1   # emergency hard-lock

# ── Owner identity ────────────────────────────────────────────────────────────
OWNER_EMAIL=appthemanger@gmail.com

# ── Dev auth bypass (development only — NEVER set in production Vercel) ───────
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
# DEV_ADMIN=true
