# DREAMengin — Environment Variable Reference
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HOW TO USE THIS FILE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
#  1. Copy this file to `.env.local` for local development.
#     Replace every `your-*` placeholder with a real value.
#     NEVER commit `.env.local`.
#
#  2. For production, add each variable to:
#       Vercel → Project → Settings → Environment Variables
#     (see docs/AUTH_SETUP.md for which variables go where)
#
#  3. Variables that start with NEXT_PUBLIC_ are bundled into the client
#     (browser) bundle by Next.js.  Never give a NEXT_PUBLIC_ prefix to
#     secrets, passwords, or auth-bypass flags.
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WHERE EACH VALUE LIVES — quick reference
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
#  ┌──────────────────────────────────────────────────────────────────────────┐
#  │  WHERE                     │  WHAT                                       │
#  ├──────────────────────────────────────────────────────────────────────────┤
#  │  .env.local                │  All vars below (dev only, gitignored)      │
#  │  Vercel env vars           │  All vars below EXCEPT DEV_BYPASS_AUTH      │
#  │                            │  and DEV_ADMIN (dev-only, never prod)       │
#  │  Supabase Auth dashboard   │  Google Client ID + Secret (NOT env vars)   │
#  │  Google Cloud Console      │  Add Supabase callback to redirect URIs     │
#  └──────────────────────────────────────────────────────────────────────────┘
#
#  See docs/AUTH_SETUP.md for full step-by-step setup instructions.
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Supabase (NEXT_PUBLIC_ = safe in browser; injected by Vercel integration) ─
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key   # legacy alias

# ── Supabase project-prefixed names (injected by Vercel-Supabase integration) ─
# These are injected automatically when you use the Vercel-Supabase integration.
# You do NOT need to set these manually if the integration is active.
dreamengin_SUPABASE_URL=https://your-project-ref.supabase.co
dreamengin_SUPABASE_ANON_KEY=your-supabase-anon-key
dreamengin_SUPABASE_JWT_SECRET=your-supabase-jwt-secret
dreamengin_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# dreamengin_SUPABASE_SECRET_KEY=your-supabase-service-role-key   # alias

# ── Supabase Postgres (injected by Vercel-Supabase integration, optional) ─────
# dreamengin_POSTGRES_URL=postgresql://...
# dreamengin_POSTGRES_URL_NON_POOLING=postgresql://...
# dreamengin_POSTGRES_PRISMA_URL=postgresql://...

# ── AI providers (server-side only — never NEXT_PUBLIC_) ─────────────────────
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# ── YouTube Data API (server-side only — never NEXT_PUBLIC_) ─────────────────
# Enables the public discovery feed (trending + world news) without OAuth.
# Get a key at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable "YouTube Data API v3" in your Google Cloud project first.
YOUTUBE_API_KEY=your-youtube-data-api-key

# ── Admin & session security (server-side only — never NEXT_PUBLIC_) ─────────
SESSION_SECRET=your-strong-random-session-secret
IDARI_PASSWORD=your-strong-idari-admin-password
ADMIN_UNLOCK_KEY=your-admin-unlock-key
# ADMIN_LOCKOUT=1   # emergency hard-lock — uncomment to force-block all admin routes

# ── Owner identity (server-side only) ────────────────────────────────────────
OWNER_EMAIL=your-owner-email@example.com

# ── Google OAuth — CLIENT ID only (server-side; secret belongs in Supabase) ──
#
# The Client ID is not a secret — it is sent in the OAuth redirect URL.
# The Client SECRET must NEVER be set here or in Vercel env vars.
# Configure both in: Supabase Dashboard → Authentication → Providers → Google
#
# For the YouTube connector only (not Supabase auth):
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-for-youtube-connector

# ── OAuth redirect URI reference (configure externally, not in env) ──────────
#
# Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs:
#   https://jnpkzaneznwnomhmvxxs.supabase.co/auth/v1/callback
#
# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs:
#   https://dreamengin.com/auth/callback
#   https://www.dreamengin.com/auth/callback
#   https://dreamengin.vercel.app/auth/callback
#   https://*-dreamengin.vercel.app/auth/callback   (preview deployments)
#   http://localhost:3000/auth/callback              (local dev)

# ── Instagram connector (server-side only — never NEXT_PUBLIC_) ──────────────
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret

# ── Dev auth bypass (local development ONLY — NEVER set in Vercel prod env) ───
#
# DEV_BYPASS_AUTH and DEV_ADMIN are server-only (no NEXT_PUBLIC_ prefix) and
# are hard-blocked at runtime when NODE_ENV=production, so they can never
# weaken a production deployment even if accidentally set.
#
# DEV_BYPASS_AUTH=true   — skips user-facing auth redirects for UI inspection
# DEV_ADMIN=true         — also unlocks admin panel without login (requires DEV_BYPASS_AUTH=true)
#
# Uncomment only in .env.local, never in Vercel environment variables:
# DEV_BYPASS_AUTH=true
# DEV_ADMIN=true
