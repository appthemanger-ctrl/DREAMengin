# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Owner Identity (REQUIRED — no fallback)
# The Supabase account email that has owner-level access to admin routes and the AI Triad.
# If this is not set, isOwner() always returns false and all admin endpoints are locked.
OWNER_EMAIL=

# ─── AI — Groq (REQUIRED for all AI features: Dr. Eams, IDARi, BoogieMan, ForgeEngin)
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ─── AI — Anthropic (CodeEngin AI Co-pilot)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── YouTube Data API v3 (server-side only)
# Required for /api/youtube/* routes and the Dreamr discovery feed.
# Get key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=

# ─── Google OAuth (YouTube Connector)
# Register at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://your-domain.com/api/connectors/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Instagram OAuth (Instagram Connector)
# Register at https://developers.facebook.com → My Apps → Instagram Basic Display
# Authorized redirect URI: https://your-domain.com/api/connectors/instagram/oauth/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ─── Generative Fill (ContentEngin — Replicate)
# Get token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ─── Voice Clone (Content Intelligence — ElevenLabs)
# Get key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# ─── Webhook Ingestion (YouTube WebSub + Meta/Instagram)
# Set a strong random string. Must match hub.verify_token in your Meta App webhook config.
# Also used to verify incoming Instagram webhooks alongside INSTAGRAM_CLIENT_SECRET.
WEBHOOK_VERIFY_TOKEN=

# ─── Cron Jobs (Vercel Cron / self-hosted scheduler)
# Set a strong random secret. Vercel sends it automatically as: Authorization: Bearer <secret>
CRON_SECRET=

# ─── CI & Security
# Strong random secret for /api/security/scan. Set same value in GitHub Actions secrets.
CI_API_KEY=

# ─── Observability (Prometheus scraping protection)
# Set a strong random token. Pass as Authorization: Bearer <token> from your Prometheus scraper.
METRICS_BEARER_TOKEN=

# ─── Optional: ShellHub device management
# SHELLHUB_API_KEY=

# ─── Optional: Hugging Face inference (dr-eams/hf route)
# HF_API_TOKEN=

# ─── Optional: LiveKit (Shared Dream voice/video rooms)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ─── App URLs (additional) ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Set by Vercel automatically on deployment (do not set manually)
# VERCEL_URL=
# NEXT_PUBLIC_VERCEL_URL=

# ─── Backend / WebSocket ─────────────────────────────────────────────────────
# Internal service backend (optional; defaults to localhost:4000 in dev)
BACKEND_URL=https://your-backend.com
NEXT_PUBLIC_BACKEND_URL=https://your-backend.com

# ─── IPFS Gateway (optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ─── Groq Model Overrides (optional — defaults are set in code) ───────────────
# GROQ_MODEL_BOOGIE=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_MODEL_EAMS_FAST=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_MODEL_EAMS_HEAVY=meta-llama/llama-4-maverick-17b-128e-instruct
# GROQ_MODEL_IDARI_FAST=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_MODEL_IDARI_HEAVY=meta-llama/llama-4-maverick-17b-128e-instruct
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# ARTISAN_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
# PROPHET_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
# WRITER_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# ─── AI (additional providers — optional) ────────────────────────────────────
# OpenAI (optional fallback or CodeEngin)
# OPENAI_API_KEY=
# OpenRouter (optional AI routing layer)
# OPENROUTER_API_KEY=
# Stability AI (optional generative image features)
# STABILITY_API_KEY=
# Generic AI provider override (if AI_PROVIDER is configured)
# AI_API_KEY=
# AI_PROVIDER=groq

# ─── BoogieMan AI Flags (optional — dev/testing only) ────────────────────────
# BOOGIE_SIMULATION_MODE=true
# BOOGIE_DEGRADED=true
# BOOGIE_OFFLINE=true

# ─── Authentication Security ──────────────────────────────────────────────────
# IDARi admin password (required for /api/ai/idari)
IDARI_PASSWORD=

# AI confirmation secrets (used to verify AI action confirmations)
AI_CONFIRM_SECRET=
AI_CONFIRM_TOKEN_SECRET=

# ─── Admin / Dev Flags (NEVER set in production) ─────────────────────────────
# DEV_BYPASS_AUTH=true
# DEV_ADMIN=true
# ADMIN_LOCKOUT=false
# ADMIN_UNLOCK_KEY=

# ─── Child Safety Reporting (NCMEC CyberTipline) ─────────────────────────────
# Required for /api/ai/boogieman/child-safety route
NCMEC_API_KEY=
NCMEC_ORG_ID=
# NCMEC_API_URL=https://api.missingkids.org/cybertipline

# ─── YouTube Analytics (optional — separate from Data API) ───────────────────
# YOUTUBE_ANALYTICS_API_KEY=

# ─── Observability / OpenTelemetry (optional) ────────────────────────────────
# OTEL_SERVICE_NAME=dreamengin
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.your-domain.com
# OTEL_METRICS_EXPORTER=otlp

# ─── Connector Tuning (optional) ─────────────────────────────────────────────
# Number of accounts processed per cron invocation (default: 50)
# CONNECTOR_CRON_BATCH_SIZE=50

# ─── LiveKit (Shared Dream rooms) — full config ───────────────────────────────
# LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── CodeEngin (optional — local dev overrides) ──────────────────────────────
# CODEENGIN_PROJECT_ROOT=/path/to/project

# ─── Auth & Session Security ──────────────────────────────────────────────────
# Strong random secret used for session signing/encryption
SESSION_SECRET=

# Supabase JWT secret — used for server-side JWT verification (optional if using anon key only)
# Found in Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ─── Google OAuth (alternate env name used in setup checks) ───────────────────
# Some routes reference GOOGLE_OAUTH_CLIENT_ID separately from GOOGLE_CLIENT_ID.
# Set both to the same value from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
