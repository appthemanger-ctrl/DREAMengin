# DREAMengin — Environment Variables
#
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# All secrets must be configured as Vercel environment variables in production.
# AI API keys are server-side only — never NEXT_PUBLIC_.
#
# See docs/SECURITY.md and README.md for full documentation.

# ── Supabase (required) ───────────────────────────────────────────────────────

# Project URL (safe to expose; used by both client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (preferred; safe to expose; enforced by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy anon key (still supported)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional namespaced variants (supported fallback names)
# NEXT_PUBLIC_dreamengin_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_dreamengin_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service-role key — server-side only, NEVER NEXT_PUBLIC_
# Required by lib/supabase/server.ts createServiceClient() for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Owner email — used by isOwner() gating in admin routes
OWNER_EMAIL=appthemanger@gmail.com

# ── AI provider (server-side only) ───────────────────────────────────────────
# All AI keys are server-only. They must NEVER appear in NEXT_PUBLIC_ vars.
# Configure these as Vercel environment variables (not exposed to the client).

# Primary AI provider key (Groq)
GROQ_API_KEY=your-groq-api-key

# Optional: override Groq model names per agent without code changes.
# All AI calls go through the Groq API using GROQ_API_KEY above.
# AI_MODEL_EAMS=meta-llama/llama-4-scout-17b-16e-instruct
# AI_MODEL_IDARI=moonshotai/kimi-k2-instruct-0905
# AI_MODEL_BOOGIEMAN=llama-guard-3-8b

# ── Admin security ────────────────────────────────────────────────────────────

# One-time password for the /api/admin/ai-chat endpoint.
# One wrong attempt locks all admin routes permanently (lib/admin/lockout.ts).
# Must be configured in Vercel; never commit the real value.
ADMIN_CODE_PASSWORD=your-strong-admin-password

# Emergency admin lockout override — set to "1" to force-lock all admin APIs
# without touching the database (e.g. during an incident).
# ADMIN_LOCKOUT=1

# ── TheBoogieMan.Ai enforcement flags ────────────────────────────────────────
# Simulation mode: produce audit events + UI banners without restricting accounts (req 61, 62).
# NEVER enable in production.
# BOOGIE_SIMULATION_MODE=true

# Mark Boogie as degraded or offline (used by GET /api/ai/boogieman/status, req 65).
# BOOGIE_DEGRADED=true
# BOOGIE_OFFLINE=true

# ── Decentralized Social Feed ────────────────────────────────────────────────
# Server-side only — never NEXT_PUBLIC_
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
NOSTR_RELAY_URLS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# ── Dev auth bypass (development only — never set in production) ──────────────
# When true, user-facing page auth redirects are skipped so the UI can be
# reviewed without a Supabase account (interface inspection mode, req #31–33).
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true

# When true (requires NEXT_PUBLIC_DEV_BYPASS_AUTH=true), the admin panel is
# also accessible without login so the admin UI can be inspected in dev.
# IDARi API endpoints remain password-protected regardless (req #32).
# DEV_ADMIN=true
