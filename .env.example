# DREAMengin — Environment Variables
#
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# Configure all variables below in Vercel → Project → Settings → Environment Variables.
#
# See README.md for full documentation.

# ── Supabase (required) ───────────────────────────────────────────────────────

# Project URL (safe to expose; used by both client and server)
NEXT_PUBLIC_dreamengin_SUPABASE_URL=https://your-project.supabase.co

# Anon / publishable key (safe to expose; enforced by RLS)
NEXT_PUBLIC_dreamengin_SUPABASE_ANON_KEY=your-anon-key

# Server-side anon key (same value as above, no NEXT_PUBLIC_ prefix)
dreamengin_SUPABASE_ANON_KEY=your-anon-key

# Publishable key alias (server-side)
dreamengin_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service-role / secret key — server-side only, NEVER expose to client
dreamengin_SUPABASE_SECRET_KEY=your-service-role-key

# JWT secret — used for verifying Supabase JWTs server-side
dreamengin_SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI providers (server-side only) ──────────────────────────────────────────

# OpenAI API key
OPENAI_API_KEY=your-openai-api-key

# Groq API key (used for EAMS / IDARi / BoogieMan agents)
GROQ_API_KEY=your-groq-api-key

# ── Session & admin security ──────────────────────────────────────────────────

# Secret used to sign session tokens
SESSION_SECRET=your-strong-session-secret

# Password required to access /api/admin/* endpoints
INNERDREAMS_PASSWORD=your-strong-admin-password

# Key to unlock admin lockout (if set, bypasses permanent lockout)
ADMIN_UNLOCK_KEY=your-admin-unlock-key

# Emergency force-lock: set to "1" to lock all admin APIs immediately
# ADMIN_LOCKOUT=1

# ── Owner identity ────────────────────────────────────────────────────────────
OWNER_EMAIL=appthemanger@gmail.com

# ── Dev auth bypass (development only — never set in production) ──────────────
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
# DEV_ADMIN=true
