{
  "name": "DREAMengin - Creative Platform",
  "short_name": "DREAM",
  "description": "A unified creator platform for social feed, content aggregation, monetization, and collaboration",
  "start_url": "/homedream",
  "display": "standalone",
  "background_color": "#020818",
  "theme_color": "#c8981a",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "social",
    "entertainment",
    "productivity",
    "music",
    "games"
  ],
  "shortcuts": [
    {
      "name": "HomeDream",
      "short_name": "Home",
      "description": "Your private daily surface",
      "url": "/homedream",
      "icons": [{ "src": "/logo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "DreamDM",
      "short_name": "Messages",
      "description": "Messages and conversations",
      "url": "/messages",
      "icons": [{ "src": "/logo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Music Daydream",
      "short_name": "Music",
      "description": "Create, organize and release music",
      "url": "/daydream/music",
      "icons": [{ "src": "/logo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Games Daydream",
      "short_name": "Games",
      "description": "Play and build games",
      "url": "/daydream/games",
      "icons": [{ "src": "/logo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Create Daydream",
      "short_name": "Create",
      "description": "Content creation tools",
      "url": "/daydream/create",
      "icons": [{ "src": "/logo-icon.png", "sizes": "192x192" }]
    },
    {
      "name": "Code Daydream",
      "short_name": "Code",
      "description": "Build and ship code",
      "url": "/daydream/code",
      "icons": [{ "src": "/logo-icon.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/hero.jpg",
      "sizes": "540x720",
      "type": "image/jpeg",
      "form_factor": "narrow"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "scope": "/",
  "dir": "ltr",
  "lang": "en-US",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "edge_side_panel": {},
  "protocol_handlers": [],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*",
            "audio/*"
          ]
        }
      ]
    }
  }
}